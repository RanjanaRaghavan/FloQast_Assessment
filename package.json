{
  "name": "floqast-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Test automation framework for a fintech microservices architecture: API, UI, and contract tests running against mock services.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mock:start": "tsx mock-services/src/server.ts",
    "mock:dev": "tsx watch mock-services/src/server.ts",
    "pretest": "playwright install --with-deps chromium",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:contract": "playwright test --project=contract",
    "test:ui": "playwright test --project=ui",
    "test:smoke": "playwright test --grep @p0",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.49.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.10",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
